// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`meeting notes view > renders sections, lists and bold owners — no raw Markdown left 1`] = `"<article class="meeting-notes" data-testid="meeting-notes"><h3 class="meeting-notes-heading">Pricing Review for Drivia Consulting Tier</h3><section class="meeting-notes-section"><h4>Summary</h4><p>The pricing review for the Drivia consulting tier is complete. The starter package will remain at forty-nine dollars a month.</p></section><section class="meeting-notes-section"><h4>Key points</h4><ul><li>The starter package will remain at forty-nine dollars a month.</li><li>A new pricing document will be sent to the team by Friday.</li><li>Wilson will book a demo with Liberty University next week.</li></ul></section><section class="meeting-notes-section"><h4>Action items</h4><ul><li><strong>Jeisil</strong> — Jeisil will send the updated pricing doc to the team by Friday (00:00:04)</li><li><strong>Wilson</strong> — Wilson to book the demo with Liberty University next week (00:00:12)</li></ul></section><section class="meeting-notes-section"><h4>Decisions</h4><ul><li>We also decided to drop the free trial for enterprise accounts (00:00:20)</li><li>The starter package will remain at forty-nine dollars a month (00:00:04)</li></ul></section><section class="meeting-notes-section"><h4>Open questions</h4><ul><li>The open question is whether annual billing gets a discount (00:00:16)</li></ul></section></article>"`;
