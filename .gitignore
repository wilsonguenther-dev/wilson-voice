__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.venv/
venv/
*.wav
# Y8-C — the four earcons are SOURCE, not recordings: embedded with include_bytes!
# and bundled as resources, so a missing file must fail the build, not vanish from git.
!desktop/src-tauri/assets/sounds/*.wav
*.aiff
# …except the committed ASR test fixtures: synthetic `say` speech (YV32's
# headless E2E gate), never captured user audio.
!desktop/src-tauri/tests/fixtures/*.wav
.DS_Store
logs/
*.log
Wilson Voice.app/
*.app/

# Tauri / frontend
desktop/node_modules/
desktop/dist/
# YV60 made `desktop/` a Cargo workspace, so the shared target dir moved up out
# of src-tauri.
desktop/target/
desktop/src-tauri/target/
desktop/src-tauri/gen/
# Tauri sidecar drop point: the release job builds yap-polish and copies it here
# under its target triple. A 4.8 MB binary is a build artifact, never a commit.
desktop/src-tauri/binaries/
*.dmg

# autonomous build-loop logs/locks
.loop/

# iCloud Desktop conflict copies (never commit — repo lives in ~/Desktop)
* [0-9].*

# Landing page is hand-authored source, not build output
!site/dist/

# Y0-E — windowed smoke captures. PNGs are evidence of one run on one machine,
# not source; --check-only deliberately fails on a fresh checkout because there
# is nothing captured yet. Y7-B: the directory itself is tracked (its README) so
# the capture root exists on a clean clone; every run under it stays ignored.
# The ONE committed reference run lives at docs/loop/smoke-reference/.
docs/smoke-shots/*
!docs/smoke-shots/README.md

# yap-qa-harness: hotkey-walk.sh self-test fixtures are hand-checked synthetic logs, never captured user logs
!scripts/qa/fixtures/*.log
!scripts/qa/fixtures/release-smoke-matrix/*.log
# Y7-D: `npm test` runs vitest with coverage of the pure modules; its report dir is output
desktop/coverage/
