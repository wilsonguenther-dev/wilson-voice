{
  "name": "wilson-voice",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "sidecar": "cargo build -p yap-polish --release && mkdir -p src-tauri/binaries && cp ${CARGO_TARGET_DIR:-target}/release/yap-polish src-tauri/binaries/yap-polish-$(rustc -vV | awk '/^host:/ {print $2}')",
    "desktop:dev": "npm run sidecar && tauri dev",
    "desktop:build": "npm run sidecar && tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.7"
  }
}
